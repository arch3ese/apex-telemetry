# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME="ApexTelemetry Platform"
API_V1_PREFIX="/api/v1"

# Database Configuration
# Async connection URL for FastAPI & asyncpg runtime
DATABASE_URL=postgresql+asyncpg://apex_user:apex_password@localhost:5432/apex_telemetry

# Synchronous connection URL for Alembic migration tooling
SYNC_DATABASE_URL=postgresql+psycopg://apex_user:apex_password@localhost:5432/apex_telemetry

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
